{
  "name": "reachinbox",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox.ai Email Scheduler - Recruitment Assignment",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,green \"npm run dev -w apps/api\" \"npm run dev -w apps/worker\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/worker && npm run build -w apps/web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "vitest run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:push:sqlite": "npm run db:push:sqlite -w apps/api"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
