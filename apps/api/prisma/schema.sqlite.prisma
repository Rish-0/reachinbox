// Prisma schema for ReachInbox.ai - SQLite version for Dockerless execution

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  googleId          String     @unique
  email             String     @unique
  name              String
  avatarUrl         String?

  slackAccessToken  String?
  slackTeamId       String?
  slackTeamName     String?
  slackChannelId    String?
  slackUserId       String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  campaigns         Campaign[]

  @@map("users")
}

model Campaign {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  sender         String
  subject        String
  body           String
  startTime      DateTime
  delayBetweenMs Int
  hourlyLimit    Int
  totalEmails    Int

  createdAt      DateTime   @default(now())

  emailJobs      EmailJob[]

  @@index([userId])
  @@map("campaigns")
}

model EmailJob {
  id            String    @id @default(uuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String

  recipient     String
  sender        String
  subject       String
  body          String
  status        String    @default("SCHEDULED")

  scheduledAt   DateTime
  sentAt        DateTime?
  smtpMessageId String?
  attempts      Int       @default(0)
  lastError     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([campaignId, recipient])
  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([sender])
  @@map("email_jobs")
}

model Session {
  id        String   @id @default(uuid())
  sid       String   @unique
  sess      String
  expire    DateTime

  @@index([expire])
  @@map("session")
}
